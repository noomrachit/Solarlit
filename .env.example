# ─────────────────────────────────────────
# Moonlit Bot — Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าให้ครบ
# ─────────────────────────────────────────

# Discord Bot (จาก Discord Developer Portal)
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/moonlit

# Session Secret (สุ่มสตริงยาวๆ ใดก็ได้)
SESSION_SECRET=change_this_to_a_random_secret_string

# Bot (optional)
BOT_HEALTH_PORT=8099
LOG_LEVEL=info
NODE_ENV=development
