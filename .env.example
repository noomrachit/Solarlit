# ─────────────────────────────────────────
# Moonlit Bot — Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าให้ครบ
# ─────────────────────────────────────────

# Discord Bot (จาก Discord Developer Portal)
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/moonlit

# Session Secret (สุ่มสตริงยาวๆ ใดก็ได้)
SESSION_SECRET=change_this_to_a_random_secret_string

# Bot (optional)
BOT_HEALTH_PORT=8099
LOG_LEVEL=info
NODE_ENV=development

# Billing / subscriptions (optional — api-server และ voicerelay ทั้งคู่ fail-open
# ถ้าไม่ตั้งค่า BILLING_DATABASE_URL คือทุก guild ผ่านหมดเหมือนไม่มีระบบ billing เลย)
BILLING_DATABASE_URL=postgresql://user:password@localhost:5432/solarlit_billing
OMISE_PUBLIC_KEY=pkey_test_your_omise_public_key
OMISE_SECRET_KEY=skey_test_your_omise_secret_key
OMISE_WEBHOOK_TOKEN=change_this_to_a_random_secret_string
